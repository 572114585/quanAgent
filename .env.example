# 复制为 .env 并填写你的 key。任一留空则该 provider 不启用,自动跳过。
# 链路顺序:Tavily → Brave → Serper → DuckDuckGo(兜底)
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# provider 额度耗尽后冷却时间(秒),默认 1 小时
SEARCH_PROVIDER_COOLDOWN_SECONDS=3600

# ===== 知识库(kb_tool)=====
# Embedding 提供方: local(本地,默认) / api(OpenAI 兼容)
KB_EMBEDDING_PROVIDER=local
# 本地模式模型名(首次启动下载约 100MB)
KB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# API 模式配置(仅 KB_EMBEDDING_PROVIDER=api 时需要)
KB_EMBEDDING_API_BASE=
KB_EMBEDDING_API_KEY=
# 知识库持久化目录(默认 workspace/kb_store)
KB_PERSIST_DIR=
# 分块参数
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_PARENT_CHUNK_SIZE=2000
# MinerU 解析配置(走云 API,复用 skills/mineru/scripts/extract.py)
# extract 模式需要 token(高精度,200MB/600页),获取:https://mineru.net/apiManage/token
MINERU_API_TOKEN=
# 无 token 时自动降级到 flash-extract(免 token,限 10MB/20页)
KB_MINERU_TIMEOUT=900
