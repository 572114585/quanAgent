# ===== LLM Provider =====
# 小米 MiMo Token Plan 可使用：LLM_PROVIDER=mimo
# agnes | deepseek | sensenova | siliconflow | volcengine | mimo（别名 ark / doubao / xiaomi）
# object-sculptor 视觉技能请用 siliconflow；日常可用 volcengine（豆包）
LLM_PROVIDER=agnes

# 小米 MiMo Token Plan（LLM_PROVIDER=mimo）
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_API_KEY=          # tp-xxxxx；也可用 MIMO_TOKEN=
# MIMO_TOKEN=

# agnes（默认）
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_API_KEY=

# deepseek（LLM_PROVIDER=deepseek）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=

# sensenova（LLM_PROVIDER=sensenova）
# SENSENOVA_MODEL=sensenova-6.7-flash-lite
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_API_KEY=

# 火山方舟 Volcengine Ark / 豆包（LLM_PROVIDER=volcengine）
# OpenAI 兼容；若 key 绑定 plan 通道请用 /api/plan/v3（标准 /api/v3 可能 401）
# LLM_PROVIDER=volcengine
# VOLCENGINE_MODEL=doubao-seed-2.1-turbo
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# VOLCENGINE_API_KEY=
# # ARK_API_KEY=   # 别名亦可

# 硅基流动 SiliconFlow（LLM_PROVIDER=siliconflow）
# 控制台创建 API Key: https://cloud.siliconflow.cn/account/ak
# 文档: https://api-docs.siliconflow.cn/docs/api/chat-completions-post
# LLM_PROVIDER=siliconflow
# SILICONFLOW_MODEL=Qwen/Qwen3.6-35B-A3B
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_API_KEY=          # 必填（Bearer token）；也可用 SILICONFLOW_TOKEN=
# # SILICONFLOW_TOKEN=
# LLM_SUPPORTS_VISION=true
# LLM_ENABLE_THINKING=false          # 建议关闭，省 TPM
# LLM_THINKING_BUDGET=4096
# LLM_MAX_RETRIES=3                  # provider retry limit
# LLM_VISION_MAX_EDGE=1280           # 视觉图最长边，减小多模态 token
# LLM_VISION_JPEG_QUALITY=85
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS=
# LLM_TIMEOUT=

# ===== PPT Master (dedicated domestic visual services) =====
# The main chat model stays unchanged. PPT image review always uses Qwen3-VL
# through SiliconFlow and image generation is locked to Volcengine Seedream.
PPT_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
PPT_VISION_TIMEOUT=120
PPT_VISION_MAX_TOKENS=2000
# Standard 10--12 page PPTX Fast lane: contract + four page workers + one QA.
PPT_FAST_DEADLINE_SECONDS=300
PPT_PAGE_CONCURRENCY=4
PPT_PAGE_TIMEOUT_SECONDS=100
PPT_IMAGE_LIMIT=3
PPT_IMAGE_CONCURRENCY=3
PPT_FAST_VISION_TIMEOUT=35
# Reuse SILICONFLOW_API_KEY and SILICONFLOW_BASE_URL above for visual review.
IMAGE_BACKEND=volcengine
PPT_ALLOWED_IMAGE_BACKENDS=volcengine
IMAGE_CONCURRENCY=2
# Agent Plan images: enter the key only in your local .env, never commit it.
ARK_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
AGENT_API_KEY=
PPT_IMAGE_MODEL=doubao-seedream-5.0-lite
VOLCENGINE_OUTPUT_FORMAT=png

# 复制为 .env 并填写你的 key。任一留空则该 provider 不启用,自动跳过。
# 链路顺序:Tavily → Brave → Serper → DuckDuckGo(兜底)
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# provider 额度耗尽后冷却时间(秒),默认 1 小时
SEARCH_PROVIDER_COOLDOWN_SECONDS=3600

# ===== Optional observability (Langfuse) =====
# Tracing starts only when both keys are present and this flag is not false.
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ===== Web 控制面 =====
# 默认仅监听本机；非回环 HOST 必须设置 AGENT_API_TOKEN
HOST=127.0.0.1
PORT=8000
AGENT_API_TOKEN=
# CORS 允许来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 前端（agent-frontend/.env）：与 AGENT_API_TOKEN 保持一致
# VITE_AGENT_API_TOKEN=
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Embedding 提供方: local(本地,默认) / api(OpenAI 兼容)
# 本地模式模型名(首次启动下载约 100MB)
# 分块参数
# MinerU 解析配置(走云 API,复用 skills/mineru/scripts/extract.py)
# extract 模式需要 token(高精度,200MB/600页),获取:https://mineru.net/apiManage/token
MINERU_API_TOKEN=
# 无 token 时自动降级到 flash-extract(免 token,限 10MB/20页)

# ===== CC 消息 Skill（发送前需 HITL 确认）=====
# CC_MSG_LOGIN_URL=https://your-cc-login-url.com/api/login
# CC_MSG_SEND_URL=https://your-cc-send-url.com/api/send
# CC_MSG_USERNAME=
# CC_MSG_PASSWORD=

# ===== MOSS（技能产物上传；未配齐 key 时跳过，仍用本地 /output 链）=====
# 桶名用 MOSS_BUCKET（也可用 MOSS_UPLOAD_BUCKET）；对象前缀默认 quan/
# MOSS_ENDPOINT=https://moss.lesso.com
# MOSS_REGION=fs
# MOSS_BUCKET=rag-uat-dev
# MOSS_UPLOAD_BUCKET=rag-uat-dev
# MOSS_ACCESS_KEY=
# MOSS_SECRET_KEY=
# MOSS_KEY_PREFIX=quan

# ===== Agent 权限 / HITL =====
# HITL_ENABLED=true                    # Web 是否启用工具审批（默认 true）
# AGENT_MODE=agent|plan                # 默认 agent
# EXECUTE_PROFILE=workspace_auto|manual
#   workspace_auto（默认）：工作区内只读探查、已知构建/测试、skills 脚本自动执行；
#                          python -c / bash -c / 联网 / 安装 / 未知命令需确认一次
#   manual：每条 execute 都弹出审批（旧行为）
# PERMISSION_EXECUTE=ask|allow|deny    # 工具级默认；workspace_auto 下再按命令细分
# PERMISSION_WRITE=ask|allow|deny      # 默认 allow（工作区内写 tmp/output）
# CHANNEL_DENY_EXECUTE=true            # 微信/企微默认拒绝 execute
# AGENT_RUN_DEADLINE_SECONDS=3600       # 单次 Web SSE 最大运行时间
# AGENT_RECURSION_LIMIT=120
# 注意：当前沙箱是「字符串策略 + 路径边界」，不是 OS 级进程隔离。
# CLI --always-approve 仅建议在外层已有容器/虚拟机隔离时使用。
# or high-importance claims to an independent LLM judge without auto-downloading.
# Escalation fails closed by default: a missing/invalid judge cannot silently
# promote an uncertain claim to supported.
