# ===== LLM Provider =====
# agnes | deepseek | sensenova | siliconflow | volcengine（别名 ark / doubao）
# object-sculptor 视觉技能请用 siliconflow；日常可用 volcengine（豆包）
LLM_PROVIDER=agnes

# agnes（默认）
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_API_KEY=

# deepseek（LLM_PROVIDER=deepseek）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=

# sensenova（LLM_PROVIDER=sensenova）
# SENSENOVA_MODEL=sensenova-6.7-flash-lite
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_API_KEY=

# 火山方舟 Volcengine Ark / 豆包（LLM_PROVIDER=volcengine）
# OpenAI 兼容；若 key 绑定 plan 通道请用 /api/plan/v3（标准 /api/v3 可能 401）
# LLM_PROVIDER=volcengine
# VOLCENGINE_MODEL=doubao-seed-2.1-turbo
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# VOLCENGINE_API_KEY=
# # ARK_API_KEY=   # 别名亦可

# 硅基流动 SiliconFlow（LLM_PROVIDER=siliconflow）
# 控制台创建 API Key: https://cloud.siliconflow.cn/account/ak
# 文档: https://api-docs.siliconflow.cn/docs/api/chat-completions-post
# LLM_PROVIDER=siliconflow
# SILICONFLOW_MODEL=Qwen/Qwen3.6-35B-A3B
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_API_KEY=          # 必填（Bearer token）；也可用 SILICONFLOW_TOKEN=
# # SILICONFLOW_TOKEN=
# LLM_SUPPORTS_VISION=true
# LLM_ENABLE_THINKING=false          # 建议关闭，省 TPM
# LLM_THINKING_BUDGET=4096
# LLM_MAX_RETRIES=8                  # 429/TPM 指数退避重试次数（硅基默认 8）
# LLM_VISION_MAX_EDGE=1280           # 视觉图最长边，减小多模态 token
# LLM_VISION_JPEG_QUALITY=85
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS=
# LLM_TIMEOUT=

# 复制为 .env 并填写你的 key。任一留空则该 provider 不启用,自动跳过。
# 链路顺序:Tavily → Brave → Serper → DuckDuckGo(兜底)
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# provider 额度耗尽后冷却时间(秒),默认 1 小时
SEARCH_PROVIDER_COOLDOWN_SECONDS=3600

# ===== Web 控制面 =====
# 默认仅监听本机；非回环 HOST 必须设置 AGENT_API_TOKEN
HOST=127.0.0.1
PORT=8000
AGENT_API_TOKEN=
# CORS 允许来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 前端（agent-frontend/.env）：与 AGENT_API_TOKEN 保持一致
# VITE_AGENT_API_TOKEN=
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ===== 知识库(kb_tool)=====
# Embedding 提供方: local(本地,默认) / api(OpenAI 兼容)
KB_EMBEDDING_PROVIDER=local
# 本地模式模型名(首次启动下载约 100MB)
KB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# API 模式配置(仅 KB_EMBEDDING_PROVIDER=api 时需要)
KB_EMBEDDING_API_BASE=
KB_EMBEDDING_API_KEY=
# 知识库持久化目录(默认 workspace/kb_store)
KB_PERSIST_DIR=
# 分块参数
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_PARENT_CHUNK_SIZE=2000
# MinerU 解析配置(走云 API,复用 skills/mineru/scripts/extract.py)
# extract 模式需要 token(高精度,200MB/600页),获取:https://mineru.net/apiManage/token
MINERU_API_TOKEN=
# 无 token 时自动降级到 flash-extract(免 token,限 10MB/20页)
KB_MINERU_TIMEOUT=900

# ===== Agent 权限 / HITL =====
# HITL_ENABLED=true                    # Web 是否启用工具审批（默认 true）
# AGENT_MODE=agent|plan                # 默认 agent
# EXECUTE_PROFILE=workspace_auto|manual
#   workspace_auto（默认）：工作区内只读探查、已知构建/测试、skills 脚本自动执行；
#                          python -c / bash -c / 联网 / 安装 / 未知命令需确认一次
#   manual：每条 execute 都弹出审批（旧行为）
# PERMISSION_EXECUTE=ask|allow|deny    # 工具级默认；workspace_auto 下再按命令细分
# PERMISSION_WRITE=ask|allow|deny      # 默认 allow（工作区内写 tmp/output）
# CHANNEL_DENY_EXECUTE=true            # 微信/企微默认拒绝 execute
# 注意：当前沙箱是「字符串策略 + 路径边界」，不是 OS 级进程隔离。
# CLI --always-approve 仅建议在外层已有容器/虚拟机隔离时使用。
